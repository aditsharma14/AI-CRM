{
  // Type-checks JSDoc in files that opt in with `// @ts-check` (same model as backend/tsconfig.json).
  // checkJs stays off so the rest of src/ isn't checked until it is migrated.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node", "@testing-library/jest-dom/vitest"]
  },
  "include": ["src", "tests", "e2e", "playwright.config.js", "vitest.config.js"]
}
