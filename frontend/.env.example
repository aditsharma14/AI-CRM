# The frontend reads one build-time flag, and nothing at runtime.
# It always calls same-origin /api/v1: Vite proxies it in dev (vite.config.js) and nginx in compose (nginx.conf).

# true builds the GitHub Pages demo instead of the app: base /AI-CRM/, the API mocked in the browser (src/demo/).
# Leave unset for every real build; scripts/check-no-demo.mjs fails if any demo code reaches a normal one.
# VITE_DEMO=true
