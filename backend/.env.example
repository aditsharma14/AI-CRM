# Every variable the API reads (backend/src/config/index.js). Production values are set on Render, never committed:
# see docs/deploy.md, whose env table this file matches. Copy to backend/.env for local runs.

# Render runs the image's NODE_ENV=production. In production a weak or placeholder JWT secret stops the boot.
NODE_ENV=development
# Render sets PORT itself; locally the API listens on 5000.
PORT=5000

# Secret. Local: a 1-node replica set (lead convert uses a transaction). Production: the Atlas user with readWrite
# on nimbus-crm only, e.g. mongodb+srv://nimbus-api:<password>@<cluster>.mongodb.net/nimbus-crm?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/nimbus-crm

# Secret. Signs the 15-minute access tokens. Production: at least 32 characters; generate with
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# (The refresh token is random and stored hashed, so it needs no secret of its own.)
JWT_ACCESS_SECRET=change-me-access-secret
ACCESS_TOKEN_TTL=15m
# 30s / 15m / 2h / 7d form; also the refresh cookie's lifetime.
REFRESH_TOKEN_TTL=7d

# The frontend's origin (CORS). Production: https://nimbus-crm.vercel.app
CLIENT_ORIGIN=http://localhost:5173

# Proxy hops of X-Forwarded-For to trust, so the rate limiter sees real client IPs. 0 locally and in compose;
# 2 in production (Vercel's rewrite, then Render's ingress).
TRUST_PROXY=0

# No email provider until S2.6. false: no password reset offered, and invite links go back to the inviting admin.
EMAIL_ENABLED=false

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# pino level: info (default), debug, warn…
LOG_LEVEL=info

# AI_SERVICE_URL (the internal FastAPI AI service) comes back with the AI proxy in S2.2.
