NODE_ENV=development
PORT=5000

# MongoDB Atlas in production; a local `mongo` container in docker-compose for dev.
MONGO_URI=mongodb://localhost:27017/nimbus-crm

# Access token is short-lived and never touches disk; refresh token is the
# long-lived one stored (hashed) on the user and shipped as an httpOnly cookie.
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Origin allowed by CORS + the cookie's SameSite policy.
CLIENT_ORIGIN=http://localhost:5173


# Internal, not public-facing — the FastAPI AI service.
AI_SERVICE_URL=http://localhost:8000

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
