NODE_ENV=development
PORT=5000

# MongoDB Atlas in production; a local `mongo` container in docker-compose for dev.
MONGO_URI=mongodb://localhost:27017/nimbus-crm

# Access token is short-lived and never touches disk; refresh token is the
# long-lived one: random, stored hashed on the user, shipped as an httpOnly cookie
# (so it needs no secret of its own).
JWT_ACCESS_SECRET=change-me-access-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Origin allowed by CORS + the cookie's SameSite policy.
CLIENT_ORIGIN=http://localhost:5173

# AI_SERVICE_URL (the internal FastAPI AI service) comes back with the AI proxy in S2.2.

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
