# Every variable the API reads (backend/src/config/index.js). Copy to backend/.env for `npm run dev`.
# docker compose sets its own values for the api container (docker-compose.yml); this file is optional there.

# The Docker image defaults to production, where a weak or placeholder JWT secret stops the boot.
NODE_ENV=development
PORT=5000

# Secret. A 1-node replica set: lead convert and signup use transactions (CLAUDE.md, "Replica set").
MONGO_URI=mongodb://localhost:27017/nimbus-crm

# Secret. Signs the 15-minute access tokens. With NODE_ENV=production it must be at least 32 characters; generate with
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# (The refresh token is random and stored hashed, so it needs no secret of its own.)
JWT_ACCESS_SECRET=change-me-access-secret
ACCESS_TOKEN_TTL=15m
# 30s / 15m / 2h / 7d form; also the refresh cookie's lifetime.
REFRESH_TOKEN_TTL=7d

# The frontend's origin (CORS).
CLIENT_ORIGIN=http://localhost:5173

# Proxy hops of X-Forwarded-For to trust, so the rate limiter sees real client IPs. 0 for npm run dev; compose sets 1
# (the client's nginx).
TRUST_PROXY=0

# No email provider until S2.6. false: no password reset offered, and invite links go back to the inviting admin.
EMAIL_ENABLED=false

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# pino level: info (default), debug, warn…
LOG_LEVEL=info

# Reported by GET /api/v1/health; "dev" when unset. CI sets it to the commit under test.
# GIT_COMMIT=

# AI_SERVICE_URL (the internal FastAPI AI service) comes back with the AI proxy in S2.2.
