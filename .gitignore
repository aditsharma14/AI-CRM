# Each service also has its own .gitignore for stack-specific artifacts
# (node_modules, .venv, dist, coverage). This one covers the repo root.
.DS_Store
Thumbs.db
.idea
.vscode/*
!.vscode/extensions.json
*.log

# Env files and anything holding real secrets — never commit these, only
# the .env.example templates. Covers root and any service directory.
.env
.env.*
!.env.example
!**/.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
*credentials*.json
*service-account*.json

# Vercel
.vercel

# Local Mongo data if ever bind-mounted instead of using the named volume
mongo-data/
