PORT=8000

# Restricts CORS to the Express API's origin — the only intended caller.
API_INTERNAL_ORIGIN=http://localhost:5000

# Read-only context fetches for RAG (see app/core/memory.py) — same Atlas
# cluster as the backend, never written to from here.
MONGO_URI=mongodb://localhost:27017/nimbus-crm

# "gemini" or "openai" — get_llm() tries this provider first and falls
# back to the other one automatically on timeout/5xx.
LLM_PROVIDER=gemini
GOOGLE_API_KEY=
OPENAI_API_KEY=
