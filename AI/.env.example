# Shared secret the Express API sends as X-Internal-Token; the same value as AI_INTERNAL_TOKEN in backend/.env.
# Required (16+ characters): the service refuses to start without it.
AI_INTERNAL_TOKEN=dev-only-internal-token-change-me

# fake (default): deterministic, offline, free. ollama: a real model running locally (docs/ai.md), also free.
AI_PROVIDER=fake
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Per brief, in milliseconds; set the same value in backend/.env (Express waits 1 s longer).
AI_TIMEOUT_MS=60000

# USD per million tokens, for the cost in logs and evals. Both providers are free; a paid one only changes these.
AI_PRICE_INPUT_PER_MTOK=0
AI_PRICE_OUTPUT_PER_MTOK=0
